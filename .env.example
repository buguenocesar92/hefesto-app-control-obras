# ---------------------------------------------------------------------------
# Control de Obras: variables de entorno
# ---------------------------------------------------------------------------
#
# ESTE ARCHIVO NO TIENE VALORES REALES Y NO DEBE TENERLOS.
# Copielo a `.env` o a `.env.prod` y complete cada variable.
#
# En `.env.prod`, los valores van en el gestor de secretos del servidor o en
# un archivo con permisos 600. Nunca en el repositorio.
#
# ---------------------------------------------------------------------------

# --- Aplicación -----------------------------------------------------------
APP_NAME="Control de Obras"
# Generar con: docker compose run --rm api php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://obras.ejemplo.cl

# --- Base de datos --------------------------------------------------------
# IMPORTANTE: el rol de la aplicación NO puede ser superusuario ni tener
# BYPASSRLS. Con superusuario, PostgreSQL ignora las políticas de aislamiento
# entre constructoras y todo el sistema se abre sin avisar.
# Verificación: docker compose run --rm api php artisan obras:verificar-aislamiento
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=control_obras
DB_USERNAME=control_obras
DB_PASSWORD=cambiar-en-produccion

# ---------------------------------------------------------------------------
# Rol de arranque de PostgreSQL
# ---------------------------------------------------------------------------
# El rol de arriba es el de la APLICACION. Este es el de arranque: la imagen
# oficial lo crea como superusuario, asi que la aplicacion NUNCA conecta con el.
# Con superusuario, PostgreSQL ignora las politicas de Row Level Security y una
# empresa podria ver los datos de otra. Los dos detalles, en docs/03.
DB_ADMIN_USERNAME=control_obras_admin
DB_ADMIN_PASSWORD=

# --- Redis (cache y colas) ------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=cambiar-en-produccion
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# --- Sesión ---------------------------------------------------------------
# En produccion la cookie DEBE ir por HTTPS.
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# --- Authentik (identidad) ------------------------------------------------
# Authentik es una pieza compartida entre las aplicaciones de Hefesto y se
# administra aparte. Ver docs/04, seccion "Authentik".
AUTHENTIK_ISSUER=https://identidad.ejemplo.cl/application/o/control-obras/
AUTHENTIK_CLIENT_ID=cambiar-en-produccion
AUTHENTIK_CLIENT_SECRET=cambiar-en-produccion
AUTHENTIK_REDIRECT_URI=https://obras.ejemplo.cl/api/v1/auth/retorno
AUTHENTIK_SCOPES="openid email profile"
# RS256 es el valor por defecto de Authentik. No se debe cambiar a `none` ni a
# un algoritmo simetrico: un token sin firma de verdad lo puede escribir cualquiera.
AUTHENTIK_ALGORITMO=RS256

# --- Despliegue -----------------------------------------------------------
# Imagenes construidas por el pipeline y referenciadas por el compose de
# produccion. Se referencian por etiqueta, no por `latest`: un despliegue tiene
# que poder decir que versión esta en pie.
API_IMAGE=registro.ejemplo.cl/hefesto/control-obras-api:0.1.0
WEB_IMAGE=registro.ejemplo.cl/hefesto/control-obras-web:0.1.0

# --- Otros ---------------------------------------------------------------
ACME_EMAIL=admin@ejemplo.cl
LOG_LEVEL=info
LOG_DAILY_DAYS=30